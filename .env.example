# ===========================================================================
# ⚠️ الملف ده للتطبيق (Android) بس.
# الـSecrets Gradle Plugin بيقرأ `.env` ويحط **كل** مفتاح جواه في `BuildConfig`
# ⇒ أي قيمة هنا بتترفع جوه الـAPK ويقدر أي حد يستخرجها.
# مفاتيح بوت الأسئلة (OpenRouter / service_role) بتتحط في scripts/.env —
# شوف scripts/.env.example.
# ===========================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://xyzcompany.supabase.co

# SUPABASE_ANON_KEY: Public anonymous key for Supabase PostgREST database access
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key

# ملاحظة: مفتاح الـanon عام بطبيعته (مع RLS)، فموجوده هنا آمن.
# أما SUPABASE_SERVICE_ROLE_KEY فممنوع يترجم جوه الملف ده — للـCI في Secrets
# أو محلياً في scripts/.env.
