# ===========================================================================
# إعدادات Bot الأسئلة — بايثون (GitHub Actions / تشغيل محلي)
# ===========================================================================
# ⚠️ الملف ده **مش** بيتقرأ من Gradle، فمفاتيحه ما بتترفعش جوه الـAPK.
#    ملف `.env` اللي في جذر المشروع مختلف: الـSecrets Gradle Plugin بيقرأه
#    ويحط **كل** مفاتيحه في `BuildConfig` — فماتحطش مفتاح البوت هناك.
#
# الاستخدام المحلي:
#     cp scripts/.env.example scripts/.env      # ثم املأ القيم
#     python3 scripts/question_bot.py --dry-run --limit 4
#
# في CI: نفس الأسماء دي بتتحدد في
#   GitHub → Settings → Secrets and variables → Actions
#   (Secrets للمفاتيح، Variables للباقي) — فملف ده مش محتاجه هناك.
# ===========================================================================

# --- 1) المفتاح (إجباري للتوليد) -------------------------------------------
# خد ده من https://openrouter.ai/keys — الطبقة المجانية بتدي 50 طلب/يوم.
OPENROUTER_API_KEY=sk-or-v1-ضع_مفتاحك_هنا

# --- 2) الـbase URL -----------------------------------------------------------
# مفتاح OpenRouter بيشتغل مع أي endpoint بيتكلم لغة OpenAI، فالتغيير ده هو
# اللي بينقلك بين المزوّدين من غير ما تلمس كود.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- 3) الموديل ---------------------------------------------------------------
# أي موديل بيسيبلة `:free` بيشتغل من غير رصيد. الموديل ده بيكتب عربي كويس
# وبيرجع JSON منتظم، وده المطلوب هنا.
# أمثلة تانية مجانية:
#   google/gemini-2.0-flash-exp:free
#   deepseek/deepseek-r1:free
#   meta-llama/llama-3.3-70b-instruct:free
# ولو حطيت موديل مدفوع (بدون ‎:free‎) هيتحاسب على التوكنات من رصيدك.
OPENROUTER_MODEL=google/gemini-2.5-flash-exp:free

# --- اختياري -----------------------------------------------------------------
# auto = OpenRouter لو فيه OPENROUTER_API_KEY، وإلا Gemini لو فيه GEMINI_API_KEY
# LLM_PROVIDER=openrouter
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# درجة الإبداع: 0.7 أكتر التزام بالواقع، 1.0 أكتر تنويع (وأكثر هلوسة)
# LLM_TEMPERATURE=0.85
# LLM_MAX_TOKENS=8000

# --- الأرقام المرتبطة بسقف 250 سؤال/يوم -------------------------------------
#: سقف النشر اليومي. 250 = 16 سؤال/نوع × 4 أنواع × 4 تشغيلات (≈256، والسقف
#: بيوقف الزيادة لوحده). لو عايز أبطأ نزّله، ولو عايز أسرع زوّده + زوّت
#: LLM_MAX_BATCH عشان عدد الطلبات يفضل تحت حد المزوّد.
QUESTION_BOT_DAILY_CAP=250

# --- تدقيق صحة الإجابة (أهم إعداد في الملف ده للجودة) -----------------------
# الفلاتر التانية بتحكم على **الشكل** بس: طول، عدد خيارات، تكرار. مافيهوش
# حاجة تعرف لو «ريال مدريد» هي الإجابة الصح فعلًا. الفحص ده بيسأل الموديل
# يراجع إجاباته ويفصل الغلط/المشبوه.
#   demote = الغلط والمشكوك فيه يتخزن pending (اللاعب ما بيشوفش غير النضيف)
#   drop   = يترفض من غير ما يتخزن
#   off    = بدون فحص
QUESTION_BOT_VERIFY=demote

# ⭐ الفرق الحقيقي في الجودة: موديل مراجعة **مختلف** عن المولّد. نفس الموديل
# بيراجع نفسه بيقع في نفس نقطة العمى، فمافيش تحسّن يُذكر في النسبة.
# مثال حي (قائمة أكتوبر 2026): google/gemma-4-31b-it:free أو
# nvidia/nemotron-3.5-lightning:free — مفيش مجاني لـ Gemini/DeepSeek/GPT على
# OpenRouter حاليًا، فمتحطش ID من مقال قديم.
#
# 🚫 ده **اسم موديل** بس. لو حطيت فيه مفتاح API (sk-...) البوت هيتجاهله
#    ويطبع تحذير — والسبب إنه لو اتحط في GitHub Variables بيتطبع نصّه الصريح
#    في لوجات Actions لأي حد على ريبو عام. المفاتيح في Secrets.
# LLM_MODEL_VERIFY=

# الأسئلة «مش متأكد منها» تتعامل معاملة الغلط؟ 1 = أيوه (الأأمن للاعب).
# لو لقيت نسبة الـpending عالية جدًا، حوّلها 0 تنشر المشبوه وتسيبه published.
# QUESTION_BOT_VERIFY_UNSURE=1
# حجم دفعة المراجعة (20 سؤال/طلب).
# QUESTION_BOT_VERIFY_BATCH=20

#: ⚠️ صمّام الأمان. true = السؤال يوصل اللاعب فوراً (اللي اخترته).
#: false = بينحفظ pending في القاعدة ومابيظهرش في اللعبة لحد ما توافقه من
#: Supabase Studio. مع 250/يوم ده المفروض: التدقيق بيمسك الصيغة مش صحة
#: المعلومة، فالموديل المجاني ممكن يختلق إجابة شكلها منطقي.
# QUESTION_BOT_AUTO_PUBLISH=true

#: أهم رقم لو على الطبقة المجانية: OpenRouter بيسمح بـ50 طلب/يوم و20/دقيقة.
#: 3 تشغيلات/يوم × 14 = 42 < 50 ⇒ في الأمان. لو زوّت عدد التشغيلات نزّل الرقم.
#: (الـworkflow بيحط 14 افتراضيًا — لو نزّلته هنا لـ12 هتحتاج 4 تشغيلات لنفس المحصول)
LLM_MAX_REQUESTS_PER_RUN=14

#: حجم دفعة التوليد. كل ما كبر، كل ما قلّ عدد الطلبات لنفس المحصول — وده
#: الثمن الحقيقي على الطبقة المجانية. 40 مرشح/طلب كفاية لـ250/يوم.
#: لو الموديل بيرفض (سياق صغير) البوت بينصّف الدفعة لوحده.
LLM_MAX_BATCH=40

#: سقف التوكنات في الرد. 40 سؤال عربي ≈ 12-16k توكن؛ القطع في نص JSON =
#: رد غير صالح كله، فارفعه مع LLM_MAX_BATCH. لو المزوّد رفض الرقم، البوت
#: بيشيل الحقل ويكمل بسقفه الافتراضي (وبيفتكر الرفض لباقي التشغيل).
LLM_MAX_TOKENS=20000

#: الدفعة الكبيرة بتاخد وقت: 40 سؤال بيتولّدوا في 40-90 ثانية على الطبقة
#: المجانية الزحمة، فـ40 ثانية القديمة كانت بتقطع ردود سليمة.
#: لو شغّلت الدفعة الكبيرة (40) والـworkflow اتقطع، نزّل LLM_MAX_BATCH لـ15:
#: الدفعات الصغيرة بترجع في 20-30 ثانية وبتقلل احتمال القطع والهلوسة معًا.
LLM_TIMEOUT_SECONDS=120
#: لو الموديل بطيء/مزدحم (openrouter/free بيصفّف ورا مستخدمين تانيين) ارفعها 150.

#: ⏱️ البوت يوقف نفسه بعد كده بالثواني وينشّط اللي جمعه ويطبع السبب. ده أهم
#: من timeout-minutes في الـworkflow: لو الـrunner هو اللي قتل العملية، اللوج
#: كله بيضيع (حصل: تشغيل اتقطع عند 12 دقيقة ملوش أي سطر). خلي الرقم أقل من
#: timeout-minutes × 60 بـ5-10 دقايق على الأقل. 0 = بدون حد ذاتي.
QUESTION_BOT_RUN_DEADLINE_SECONDS=1500

#: محاولات التوليد لكل نوع. 8 (كانت 4) لأن السقف الكبير معناه دفعات أكتر
#: ومرفوضات أكتر، و4 محاولات ما بتلمّى بيهم 60 سؤال صالح.
LLM_MAX_ATTEMPTS=8

# --- سياسة المحتوى -----------------------------------------------------------
# mostly_hard = 50% صعب / 35% متوسط / 15% سهل (الافتراضي)
# hard = الدفعة كلها صعبة إجباريًا | medium_hard = متوسط/صعب من غير سهل
# mixed = توزيع متوازن | easy | medium | mostly_easy | أوزان صريحة
# مثال الأوزان: "easy=1,medium=2,hard=1"
# QUESTION_BOT_DIFFICULTY=mostly_hard

# (راجع الأرقام فوق في قسم 250/يوم)

# --- Supabase ----------------------------------------------------------------
# مفتاح service_role بس هو اللي بيقدر يكتب. في CI خليه في Secrets؛ ولو حطيته
# هنا يبقى على جهازك وبس (الملف ده داخل .gitignore عن طريق قاعدة .env).
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
